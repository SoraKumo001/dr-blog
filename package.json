{
  "name": "cloud-blog",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "app/server/graphql/**/*.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:react-router": "react-router dev --port 3000",
    "dev:docker": "docker compose -f docker/development/docker-compose.yml up -d",
    "dev:codegen": "graphql-codegen -c codegen/codegen.ts -w",
    "lint": "eslint app",
    "lint:fix": "eslint --fix app",
    "start": "pnpm run build && wrangler dev",
    "start:remote": "pnpm run build && wrangler dev --remote",
    "typecheck": "tsc --noEmit --pretty",
    "typegen": "wrangler types",
    "build": "react-router build",
    "deploy": "pnpm run build && wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "deploy-secret": "wrangler secret bulk .env.production",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "tsx tools/change-schema && drizzle-kit migrate && tsx tools/change-schema public",
    "drizzle:reset": "tsx tools/reset.ts && npm run drizzle:migrate",
    "graphql:schema": "tsx --tsconfig tsconfig.cloudflare.json ./tools/exportSchema.ts",
    "log": "wrangler tail dr-blog"
  },
  "dependencies": {
    "@firebase/app": "^0.14.12",
    "@firebase/auth": "^1.13.1",
    "@graphql-tools/utils": "11.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@node-libraries/semaphore": "^1.0.3",
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-drizzle": "0.17.4",
    "@react-libraries/next-exchange-ssr": "^1.0.10",
    "@react-router/dev": "^7.15.1",
    "@react-router/fs-routes": "^7.15.1",
    "@urql/exchange-retry": "^2.0.0",
    "apollo-explorer": "1.1.6",
    "cloudflare-fonts": "0.0.2",
    "cookie": "^1.1.1",
    "drizzle-orm": "1.0.0-beta.11-05230d9",
    "firebase-storage": "^1.1.4",
    "graphql": "^16.14.0",
    "graphql-yoga": "^5.21.0",
    "hono": "^4.12.22",
    "jose": "^6.2.3",
    "monaco-editor": "^0.55.1",
    "pg": "8.21.0",
    "pothos-drizzle-generator": "0.2.0",
    "prism-react-renderer": "^2.4.1",
    "pure-uuid": "^2.0.0",
    "react": "19.2.6",
    "react-daisyui": "^5.0.5",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-icons": "^5.6.0",
    "react-router": "^7.15.1",
    "react-router-dom": "^7.15.1",
    "rehype-raw": "7.0.0",
    "rehype-react": "8.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sql-formatter": "15.8.0",
    "thumbhash": "0.1.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "urql": "^5.0.2",
    "vfile": "6.0.3",
    "wasm-image-optimization": "2.0.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.38.0",
    "@cloudflare/workers-types": "^4.20260523.1",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.2",
    "@graphql-codegen/typescript-urql": "^5.0.1",
    "@storybook/react": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/hast": "3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/unist": "^3.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-spawn": "^7.0.6",
    "daisyui": "5.5.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-beta.11-05230d9",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-better-tailwindcss": "4.5.0",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "graphql-scalars": "1.25.0",
    "graphql-tag": "^2.12.6",
    "npm-run-all": "^4.1.5",
    "pg-connection-string": "2.13.0",
    "pothos-schema-exporter": "^1.0.0",
    "rimraf": "6.1.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "8.0.14",
    "vite-plugin-babel": "1.7.3",
    "wrangler": "^4.94.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "resolutions": {
    "async-function": "0.1.0"
  },
  "version": "1.0.0",
  "main": "index.js",
  "author": "SoraKumo <info@croud.jp>",
  "license": "MIT",
  "repository": "https://github.com/SoraKumo001/dr-blog.git"
}

{
  "name": "cloud-blog",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "app/server/graphql/**/*.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:react-router": "react-router dev --port 3000",
    "dev:docker": "docker compose -f docker/development/docker-compose.yml up -d",
    "dev:codegen": "graphql-codegen -c codegen/codegen.ts -w",
    "lint": "eslint app",
    "lint:fix": "eslint --fix app",
    "start": "pnpm run build && wrangler dev",
    "start:remote": "pnpm run build && wrangler dev --remote",
    "typecheck": "tsc --noEmit --pretty",
    "typegen": "wrangler types",
    "build": "react-router build",
    "deploy": "pnpm run build && wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "deploy-secret": "wrangler secret bulk .env.production",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "tsx tools/change-schema && drizzle-kit migrate && tsx tools/change-schema public",
    "drizzle:reset": "tsx tools/reset.ts && npm run drizzle:migrate",
    "graphql:schema": "tsx --tsconfig tsconfig.cloudflare.json ./tools/exportSchema.ts",
    "log": "wrangler tail dr-blog"
  },
  "dependencies": {
    "@firebase/app": "^0.15.1",
    "@firebase/auth": "^1.13.3",
    "@graphql-tools/utils": "11.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@node-libraries/semaphore": "^1.0.3",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-drizzle": "0.17.5",
    "@react-libraries/next-exchange-ssr": "^1.0.10",
    "@react-router/dev": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@urql/exchange-retry": "^2.0.0",
    "apollo-explorer": "1.1.6",
    "cloudflare-fonts": "0.0.2",
    "cookie": "^2.0.1",
    "drizzle-orm": "1.0.0-beta.11-05230d9",
    "firebase-storage": "^1.1.4",
    "graphql": "16.14.2",
    "graphql-yoga": "^5.21.2",
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "monaco-editor": "^0.56.0",
    "pg": "8.22.0",
    "pothos-drizzle-generator": "0.2.0",
    "prism-react-renderer": "^2.4.1",
    "pure-uuid": "^2.0.0",
    "react": "19.2.8",
    "react-daisyui": "^5.0.5",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.1",
    "rehype-raw": "7.0.0",
    "rehype-react": "8.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sql-formatter": "15.8.2",
    "thumbhash": "0.1.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "urql": "^5.0.3",
    "vfile": "6.0.3",
    "wasm-image-optimization": "2.0.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@graphql-codegen/typescript-urql": "^5.0.1",
    "@storybook/react": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/hast": "3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/unist": "^3.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-spawn": "^7.0.6",
    "daisyui": "5.7.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-beta.11-05230d9",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "graphql-scalars": "1.25.0",
    "graphql-tag": "^2.12.7",
    "npm-run-all": "^4.1.5",
    "pg-connection-string": "2.14.0",
    "pothos-schema-exporter": "^1.0.0",
    "rimraf": "6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.5",
    "vite-plugin-babel": "1.7.3",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "resolutions": {
    "async-function": "0.1.0"
  },
  "version": "1.0.0",
  "main": "index.js",
  "author": "SoraKumo <info@croud.jp>",
  "license": "MIT",
  "repository": "https://github.com/SoraKumo001/dr-blog.git"
}
